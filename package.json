{
  "name": "ts-eslint-base",
  "type": "module",
  "version": "2.0.3",
  "description": "",
  "author": "Oliver Mak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oliver139/ts-eslint-base"
  },
  "keywords": [],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "initialize": "git reset $(git commit-tree \"HEAD^{tree}\" -m \"Initialize\")",
    "build": "tsdown --clean --dts",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:inspect": "eslint --inspect-config",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "prepare": "simple-git-hooks",
    "prepack": "nr build",
    "release": "bumpp && pnpm publish",
    "analyze": "nlx node-modules-inspector"
  },
  "devDependencies": {
    "@antfu/ni": "^24.3.0",
    "@oliver139/eslint-config": "^2.1.1",
    "@tsconfig/recommended": "1.0.8",
    "@types/node": "^22.13.12",
    "bumpp": "^10.1.0",
    "eslint": "^9.23.0",
    "simple-git-hooks": "^2.12.1",
    "tsdown": "^0.22.3",
    "tsdown-stale-guard": "^0.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
